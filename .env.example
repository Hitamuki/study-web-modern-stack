# ==========================================================================
# 環境変数サンプル
#   使い方: このファイルを `.env` にコピーして実値を埋める。
#   .env はコミット禁止（.gitignore 済み）。秘匿値は直書きしない方針。
#   **キーの並びは .env と同じ順序に揃えてある。** 差分を取りやすくするため。
# ==========================================================================

# --- Supabase Auth（認証。Discussion #19）---------------------------------
# プロジェクトの Reference ID（20 文字の小文字英数字）。
# Supabase ダッシュボードの URL https://supabase.com/dashboard/project/<ここ>
# または Project Settings > General の Reference ID から取得する。
# Hasura はこの値から JWKS の URL を組み立てて JWT の署名を検証する。
SUPABASE_PROJECT_REF=""

# publishable key（旧 anon key）。**公開前提の値**でブラウザに載る。
# service_role キーは絶対にここへ書かない（全権を持つため）。
SUPABASE_PUBLISHABLE_KEY=""

# --- Hasura ---------------------------------------------------------------
# 管理用の全権シークレット。**クライアントに配らない**（サーバー間と開発用）。
#
# この既定値は **ローカル専用**。以前 hasura/config.yaml に平文で入っていた値で、
# リポジトリは public、値はコミット履歴に残っている（#89）。行を消しても履歴からは
# 消えないため、**本番の admin secret は必ずこれと別の値にする**。
#   生成例: openssl rand -hex 32
HASURA_GRAPHQL_ADMIN_SECRET="myadminsecretkey"

# Hasura CLI（hasura metadata apply / codegen）の向き先。
# CLI の優先順位は「フラグ > 環境変数 > .env > config.yaml」なので、
# この値が hasura/config.yaml の endpoint を上書きする。
HASURA_GRAPHQL_ENDPOINT="http://localhost:8080"

# Actions のハンドラ（NestJS）のベース URL。
# hasura/metadata/actions.yaml の handler が {{ACTION_BASE_URL}} で参照し、
# **Hasura サーバーの環境変数として**解決される（docker-compose.yml が渡す）。
# host.docker.internal は Docker Desktop 固有の名前で、クラウドでは解決できない。
ACTION_BASE_URL="http://host.docker.internal:3001"

# Hasura が許可するオリジン。ローカルは全許可のままでよい。
# 公開時は Web のオリジンに絞る（層 10 / #104）。
HASURA_GRAPHQL_CORS_DOMAIN="*"

# --- Hasura Actions の保護（#26）------------------------------------------
# Hasura がハンドラ（NestJS）へ付与する共有シークレット。両者で同じ値を使う。
# ハンドラは Hasura のパーミッションを迂回して DB に触るため、この値で
# 「Hasura からの呼び出しか」を検証する。任意のランダム文字列を設定すること。
#   生成例: openssl rand -hex 32
# apps/api/.env にも同じ値を設定する。
HASURA_ACTION_SECRET=""

# --- apps/web が使う Supabase の値（#24）----------------------------------
# どちらも公開前提の値。ビルド成果物に含まれ、ブラウザから読める。
VITE_SUPABASE_URL="https://<SUPABASE_PROJECT_REF>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- 検証用ユーザー（#20 / #74）--------------------------------------------
# 行レベル権限の分離を確認するために Supabase ダッシュボードの
# Authentication > Users > Add user（Auto Confirm）で作る。
# UID は作成後に一覧から控え、apps/api/prisma/seed.sql の owner_id と揃える。
# 作り方: project/plan/auth/manual/supabase-users.md
# 再投入: project/plan/auth/manual/reseed.md
SUPABASE_USER_EMAIL_1=""
SUPABASE_USER_PASSWORD_1=""
SUPABASE_USER_UID_1=""

# --- フロントエンドの接続先 -------------------------------------------------
# ビルド時にクライアントへ埋め込まれる。秘匿値を入れないこと。
# Vite（apps/web / apps/desktop の renderer）は VITE_ 接頭辞のみ埋め込む。
VITE_GRAPHQL_URL="http://localhost:8080/v1/graphql"

# --- apps/desktop -----------------------------------------------------------
# パスワード再設定の案内先。デスクトップはメールのリンクを受け取れないため Web へ誘導する。
VITE_WEB_APP_URL="http://localhost:5173"

# --- apps/mobile ------------------------------------------------------------
# Expo は EXPO_PUBLIC_ 接頭辞のみクライアントへ埋め込む。いずれも公開前提の値。
# 未設定だと起動後に supabaseUrl is required で失敗する（make mobile-start が事前に検出）。
# 実機や Expo Go から繋ぐ場合は localhost ではなく PC の IP を指定する。
EXPO_PUBLIC_SUPABASE_URL="https://<SUPABASE_PROJECT_REF>.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
EXPO_PUBLIC_GRAPHQL_URL="http://localhost:8080/v1/graphql"

# --- 認証メールの送信（Resend / #71）--------------------------------------
# supabase/config.toml の [auth.email.smtp] が pass = "env(RESEND_API_KEY)" で
# この値を参照する。`supabase config push` でホスト版プロジェクトへ適用される。
#
# 送信するのは Supabase のサーバーで、apps/api も apps/web もメールを送らない。
# そのため **apps/api/.env ではなくリポジトリ直下のこの .env に置く**。
#
# Resend の API キー（Dashboard → API Keys）。SMTP の Password として使う。
#   Host: smtp.resend.com / Port: 587 / Username: resend（固定文字列）
RESEND_API_KEY=""

# 以下 2 つは疎通確認スクリプト（make resend-test）専用。認証メールの本番送信には使わない。
# 送信元: 検証済みドメインのアドレス。ドメイン未検証なら onboarding@resend.dev のみ。
RESEND_FROM="noreply@<自分のドメイン>"
# 宛先: ドメイン未検証のうちは **Resend アカウントの登録アドレス宛にしか届かない**。
RESEND_TEST_TO=""

# 手順:   project/plan/auth/manual/resend-smtp.md
# 解説:   project/plan/auth/explain/email.md

# --- インフラ（Terraform / #100）-------------------------------------------
# infra/ の Terraform が TF_VAR_* として読む。make infra-plan / infra-test が渡す。
# **秘匿値はこの 2 つだけ。** アカウント ID / ゾーン ID / ワークスペース ID は
# 秘匿値ではないため infra/variables.tf の既定値として持っている。
#
# Cloudflare の API トークン（My Profile > API Tokens > Create Token > Custom token）。
# 権限は Account: Workers Scripts:Edit / Zone: DNS:Edit, Zone:Read, Workers Routes:Edit。
# Zone Resources は sk8trickhub.com に絞ること。**値は作成時に一度しか表示されない**。
CLOUDFLARE_API_TOKEN=""

# Render の API キー（Account Settings > API Keys）。
# **権限スコープの設定は無く、アカウント全体に効く。** こちらも作成時のみ表示。
RENDER_API_KEY=""

# GitHub の token はここに置かない。make infra-* が gh auth token から取る。
#
# state はローカル（infra/terraform.tfstate。.gitignore 済み）。
# **state には秘匿値が平文で入るのでコミットしないこと。**

# ==========================================================================
# MCP サーバー用（.mcp.json が ${VAR} で参照する）
#   アプリの動作には不要。エージェントのツール連携でのみ使う。
#   http 系（notion / sentry）はブラウザ OAuth 認証なので env 不要。
# ==========================================================================

# --- Context7（ライブラリ最新ドキュメント参照）------------------------------
# 無料枠なら未設定でも動作。レート上限を上げたい場合のみ設定。
# https://context7.com/dashboard で取得
CONTEXT7_API_KEY=""

# --- GitHub（公式リモート MCP / PAT 認証）----------------------------------
# repo / read:org 等の scope を付与。https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=""

# --- Google Workspace（Gmail / Drive / Calendar 等）------------------------
# Google Cloud Console で OAuth クライアント（デスクトップ/ウェブ）を作成
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Slack -----------------------------------------------------------------
# Slack App の Bot Token（xoxb-...）とワークスペースの Team ID（T から始まる）
SLACK_BOT_TOKEN=""
SLACK_TEAM_ID=""

# --- PostgreSQL（postgres-mcp / restricted モード）-------------------------
# docker-compose の DB。ホストからは 5433。apps/api/.env の DATABASE_URL と同じ接続先。
DATABASE_URI="postgres://user:password@localhost:5433/memo"

# --- Web 検索: Tavily -------------------------------------------------------
# https://app.tavily.com/home で取得（tvly-...）
TAVILY_API_KEY=""

# --- Web 検索: Exa ----------------------------------------------------------
# https://dashboard.exa.ai/api-keys で取得
EXA_API_KEY=""
