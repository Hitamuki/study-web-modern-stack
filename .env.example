# ==========================================================================
# MCP サーバー用 環境変数サンプル（.mcp.json が ${VAR} で参照する）
#   使い方: このファイルを `.env` にコピーして実値を埋める。
#   .env はコミット禁止（.gitignore 済み）。秘匿値は直書きしない方針。
#   http 系（notion / sentry）はブラウザ OAuth 認証なので env 不要。
# ==========================================================================

# --- Context7（ライブラリ最新ドキュメント参照）------------------------------
# 無料枠なら未設定でも動作。レート上限を上げたい場合のみ設定。
# https://context7.com/dashboard で取得
CONTEXT7_API_KEY=""

# --- GitHub（公式リモート MCP / PAT 認証）----------------------------------
# repo / read:org 等の scope を付与。https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=""

# --- Google Workspace（Gmail / Drive / Calendar 等）------------------------
# Google Cloud Console で OAuth クライアント（デスクトップ/ウェブ）を作成
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Slack -----------------------------------------------------------------
# Slack App の Bot Token（xoxb-...）とワークスペースの Team ID（T から始まる）
SLACK_BOT_TOKEN=""
SLACK_TEAM_ID=""

# --- PostgreSQL（postgres-mcp / restricted モード）-------------------------
# docker-compose の DB。ホストからは 5433。apps/api/.env の DATABASE_URL と同じ接続先。
DATABASE_URI="postgres://user:password@localhost:5433/memo"

# --- Web 検索: Tavily -------------------------------------------------------
# https://app.tavily.com/home で取得（tvly-...）
TAVILY_API_KEY=""

# --- Web 検索: Exa ----------------------------------------------------------
# https://dashboard.exa.ai/api-keys で取得
EXA_API_KEY=""
