// docs/er-diagram.md に合わせた dummy テーブル定義
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SCR-005 ダミー画面の検証用テーブル。実際のドメインが固まるまでの仮置き。
model Dummy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 所有者は Supabase Auth のユーザー ID（auth.users.id、JWT の sub クレーム）。形式は UUID。
  // users テーブルを持たず外部キー制約も張らないのは、ユーザーの実体が Supabase 側の
  // 別 PostgreSQL にあるため（ローカル開発では docker-compose の PostgreSQL を使う）。
  // 参照整合性を DB で担保できない代わりに、形式の検証はドメイン層の OwnerId が受け持つ。
  ownerId   String   @map("owner_id") @db.Uuid
  content   String   @db.Text
  // 日時はドメイン層（UseCase）が明示的に決める。default はコンソールなどからの直接 INSERT 用の保険。
  // Hasura がオフセット付きで返すよう timestamptz を使う（timestamp だとクライアントがローカル時刻と誤読する）。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Hasura の行レベル権限が全クエリで owner_id を条件に入れるため索引を張る。
  @@index([ownerId])
  @@map("dummy")
}
