// docs/er-diagram.md に合わせた dummy テーブル定義
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SCR-001 ダミー画面の検証用テーブル。実際のドメインが固まるまでの仮置き。
model Dummy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String   @db.Text
  // 日時はドメイン層（UseCase）が明示的に決める。default はコンソールなどからの直接 INSERT 用の保険。
  // Hasura がオフセット付きで返すよう timestamptz を使う（timestamp だとクライアントがローカル時刻と誤読する）。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("dummy")
}
